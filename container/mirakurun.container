# mirakurun.container - rootless systemd (Quadlet) ユニット
#
# rootless で Mirakurun を常駐運用するための Quadlet 定義です。
# docker-compose.yml / podman.sh の設定を Quadlet に翻訳したものです。
#
# 配置と有効化 (実行ユーザで実施):
#   1. 事前準備
#        # 実行ユーザを各デバイスの所有グループに追加 (例)
#        sudo usermod -aG video,dialout <user>
#        # ログイン中でなくても user サービスを動かすため linger を有効化
#        sudo loginctl enable-linger <user>
#        # ボリュームを実行ユーザ所有で作成
#        mkdir -p /opt/mirakurun/volumes/{run,opt,config,data}
#   2. このファイルを設置
#        mkdir -p ~/.config/containers/systemd
#        cp container/mirakurun.container ~/.config/containers/systemd/
#   3. AddDevice= を実行環境のチューナー/カードリーダーに合わせて編集 (下記参照)
#   4. 反映・起動
#        systemctl --user daemon-reload
#        systemctl --user start mirakurun
#        systemctl --user status mirakurun
#        journalctl --user -u mirakurun -f   # ログ追従

[Unit]
Description=Mirakurun (rootless)
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=mirakurun
# podman.sh build で作成したローカルイメージ
Image=chinachu/mirakurun:latest

# network_mode: host
Network=host

# cap_add
AddCapability=SYS_ADMIN
AddCapability=SYS_NICE

# rootless: ホストの補助グループ (video 等) を引き継ぎデバイスへアクセス
GroupAdd=keep-groups

# tmpfs: /tmp
Tmpfs=/tmp

# logging: json-file (max-size 10m)
LogDriver=json-file
PodmanArgs=--log-opt max-size=10m

# environment
Environment=TZ=Asia/Tokyo
Environment=DISABLE_PCSCD=0
Environment=DISABLE_B25_TEST=0
Environment=DOCKER_NETWORK=host

# volumes
Volume=/opt/mirakurun/volumes/run:/var/run
Volume=/opt/mirakurun/volumes/opt:/opt
Volume=/opt/mirakurun/volumes/config:/app-config
Volume=/opt/mirakurun/volumes/data:/app-data

# devices: 実行環境のチューナー/カードリーダーに合わせて追記・編集する
#   USB カードリーダー:
#AddDevice=/dev/bus/usb
#   DVB チューナー:
#AddDevice=/dev/dvb

# USB カードリーダー
AddDevice=/dev/bus/usb
# PX-M1UR
AddDevice=/dev/pxm1urvideo0

# ホストの pcscd を共有する場合は Environment=DISABLE_PCSCD=1 にし、以下を追加:
#Volume=/run/pcscd/pcscd.comm:/run/pcscd/pcscd.comm

[Service]
Restart=always

[Install]
WantedBy=default.target
